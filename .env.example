# 로컬 개발은 .env.local에 복사해서 사용한다.
# GitHub Pages 배포는 GitHub repo Variables에서 같은 이름으로 주입한다.

# 백엔드 API 주소 (OAuth 리다이렉트·토큰 교환)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth public client id (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps JavaScript API browser key (Maps JavaScript API 활성화 필요)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# true(기본): VITE_GOOGLE_CLIENT_ID로 프론트에서 Google 로그인 (백엔드 불필요)
# false: 백엔드 /api/auth/google 로 리다이렉트 (백엔드 실행 필요)
VITE_USE_GOOGLE_SDK=true

# 카카오 JavaScript 키 (설정 시 SDK authorize 사용, 미설정 시 백엔드 리다이렉트)
VITE_KAKAO_JS_KEY=

# 카카오 콘솔에 등록한 Redirect URI (기본: http://localhost:5173/auth/kakao/callback)
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
